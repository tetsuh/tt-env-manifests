# Manifest for Ubuntu 22.04 (Jammy Jellyfish)
# Catalog validation parses this file as data and never sources it.

PKG_MANAGER="apt"
USE_SYSTEM_PACKAGES="true"

# Official Tenstorrent APT base URL supplied unchanged to tt-env-go's native
# repository adapter. Upstream documentation describes its jammy source line.
REQUIRED_REPOS=(
  "https://ppa.tenstorrent.com/ubuntu/"
)

VIRT_PKG_CMAKE="cmake"
VIRT_PKG_NINJA="ninja-build"
VIRT_PKG_ZLIB="zlib1g-dev"
VIRT_PKG_KMD="tenstorrent-dkms"
VIRT_PKG_SMI="tt-smi"
VIRT_PKG_FLASH="tt-flash"
VIRT_PKG_TOPOLOGY="tt-topology"
VIRT_PKG_METALIUM="tt-metalium"

WORKAROUNDS=()
